# Groq API Configuration (Free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Together AI API Key (Backup / Llama-70B)
TOGETHER_API_KEY=

# Default Model Configuration
# Options on Groq:
#   - llama-3.1-8b-instant (Primary Llama-class baseline)
#   - mixtral-8x7b-32768   (Mistral MoE architecture)
#   - gemma2-9b-it         (Google Gemma architecture)
COPILOT_DEFAULT_MODEL=llama-3.1-8b-instant
COPILOT_TEMPERATURE=0.0

# Rate Limiting & Sleep (seconds between API calls for Groq free-tier)
API_CALL_DELAY=2.0
